# Frontend Environment Variables (Vite requires VITE_ prefix)

# Optional: Set the backend API URL directly if not using proxy / rewrites.
# In local development: Leave empty or commented to use Vite's built-in proxy (target: http://127.0.0.1:5001)
# In production (e.g., Vercel): Set this if your frontend directly queries backend cross-domain.
# VITE_API_URL=http://localhost:5001/api
# VITE_API_URL=https://your-backend.onrender.com/api
