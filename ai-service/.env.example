# AI Service Environment Configuration
PORT=8000
HOST=0.0.0.0

# Database Connection (Neon PostgreSQL or Local PostgreSQL)
DATABASE_URL=postgresql://nla_user:nla_dev_password@localhost:5432/nla_db

# Optional: Google Gemini / LLM API Key for advanced multimodal reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Tesseract OCR Path (optional on Windows if not in standard PATH: C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
